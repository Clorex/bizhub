};

export const DISPUTE_THRESHOLDS = {
  excellent: 2,     // <2%
  acceptable: 5,    // <5%
};

export function scoreToLabel(total: number): MatchLabel {
  const t = Number(total || 0);
  if (t >= 85) return "best_match";
  if (t >= 70) return "recommended";
  if (t >= 50) return "fair_match";
  return "low_match";
}

